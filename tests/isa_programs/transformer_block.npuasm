# transformer_block.npuasm — integration sample: one Llama-style transformer
# block (single head) exercising the whole op stack end to end.
#
#   seq S=4, model dim D=8 (= head_dim), FFN hidden H=16, fp32.
#
#   RMSNorm -> Q/K/V matmuls -> RoPE(Q,K) -> scores = Q . K^T -> softmax
#   -> attn = scores . V -> output proj -> residual add
#   -> RMSNorm -> FFN (matmul -> SiLU -> matmul) -> residual add -> store
#
# K^T is a strided (transposed) VIEW of K (":1,8"), so no transpose op is needed.
# Weights are small constants and the input is bounded, so the result stays finite.
# This is a structural integration test (the simulator runs a realistic layer and
# produces a full perf + energy report); wrap the compute in LOOP $N for N layers
# (the residual stream x is reused, so keep producer/consumer on one engine).

# ---- DDR: input, norm gains, weights, output ----
.desc dx   ddr  f32 0x00000 4x8
.desc dg1  ddr  f32 0x00200 8
.desc dg2  ddr  f32 0x00240 8
.desc dWq  ddr  f32 0x00300 8x8
.desc dWk  ddr  f32 0x00400 8x8
.desc dWv  ddr  f32 0x00500 8x8
.desc dWo  ddr  f32 0x00600 8x8
.desc dW1  ddr  f32 0x00700 8x16
.desc dW2  ddr  f32 0x00900 16x8
.desc dout ddr  f32 0x00B00 4x8
.data dx  rand 7
.data dg1 const 1
.data dg2 const 1
.data dWq const 0.1
.data dWk const 0.1
.data dWv const 0.1
.data dWo const 0.1
.data dW1 const 0.1
.data dW2 const 0.1

# ---- SRAM activations ----
.desc x      sram f32 0x0000 4x8
.desc xn     sram f32 0x0100 4x8
.desc q      sram f32 0x0200 4x8
.desc k      sram f32 0x0300 4x8
.desc kT     sram f32 0x0300 8x4 :1,8     # transposed view of k
.desc v      sram f32 0x0400 4x8
.desc scores sram f32 0x0500 4x4
.desc attn   sram f32 0x0600 4x8
.desc attno  sram f32 0x0700 4x8
.desc ffn1   sram f32 0x0800 4x16
.desc ffn2   sram f32 0x0A00 4x8

# ---- SRAM weights (loaded from DDR) ----
.desc g1 sram f32 0x0B00 8
.desc g2 sram f32 0x0B40 8
.desc Wq sram f32 0x0C00 8x8
.desc Wk sram f32 0x0D00 8x8
.desc Wv sram f32 0x0E00 8x8
.desc Wo sram f32 0x0F00 8x8
.desc W1 sram f32 0x1000 8x16
.desc W2 sram f32 0x1200 16x8

# ---- stage inputs + weights into SRAM (DMA engine, in-order) ----
DMA.LOAD x  dx
DMA.LOAD g1 dg1
DMA.LOAD g2 dg2
DMA.LOAD Wq dWq
DMA.LOAD Wk dWk
DMA.LOAD Wv dWv
DMA.LOAD Wo dWo
DMA.LOAD W1 dW1
DMA.LOAD W2 dW2          @sig 0

# ---- attention ----
RMSNORM xn x g1 $0.00001 @wait 0 @sig 1
MATMUL  q xn Wq          @wait 1 @sig 2
MATMUL  k xn Wk          @sig 3
MATMUL  v xn Wv          @sig 4
ROPE    q q $10000 $0    @wait 2 @sig 5
ROPE    k k $10000 $0    @wait 3 @sig 6
MATMUL  scores q kT      @wait 6 @sig 7
SOFTMAX scores scores    @wait 7 @sig 8
MATMUL  attn scores v    @wait 8 @sig 9
MATMUL  attno attn Wo    @sig 10
VADD    x x attno        @wait 10 @sig 11

# ---- feed-forward ----
RMSNORM xn x g2 $0.00001 @sig 12
MATMUL  ffn1 xn W1       @wait 12 @sig 13
SILU    ffn1 ffn1        @wait 13 @sig 14
MATMUL  ffn2 ffn1 W2     @wait 14 @sig 15
VADD    x x ffn2         @wait 15 @sig 16

DMA.STORE dout x         @wait 16
HALT
